module adder_4bit #(parameter WIDTH = 4)(
input [WIDTH-1:0]a,b, 
input carry_in, 
output [WIDTH-1:0]sum, 
output carry_out);
	wire [WIDTH-1:0]carry;
	Sumador #(WIDTH(4)) adder0(.a(a[0]),.b(b[0]),.carry_in(carry_in),.sum(sum[0]),.carry_out(carry[0]));
	Sumador #(WIDTH(4)) adder1(.a(a[1]),.b(b[1]),.carry_in(carry[0]),.sum(sum[1]),.carry_out(carry[1]));
	Sumador #(WIDTH(4)) adder2(.a(a[2]),.b(b[2]),.carry_in(carry[1]),.sum(sum[2]),.carry_out(carry[2]));
	Sumador #(WIDTH(4)) adder3(.a(a[3]),.b(b[3]),.carry_in(carry[2]),.sum(sum[3]),.carry_out(carry[3]));
	assign carry_out = carry[3];
endmodule 