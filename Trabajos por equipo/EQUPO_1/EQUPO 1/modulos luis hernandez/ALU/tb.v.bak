module tb;
reg[3:0]a;
reg[3:0]b;
reg[1:0]control;
wire[3:0]result;
ALU ALU_0(.a(a)),
         .b(b),
			.control(control),
			.result(result);
initial begin 
#10
//add
repeat (25) begin
a = $random;
b = $random;
control = 2'd0;
#10
end
repeat (25) begin
a = $random;
b = $random;
control = 2'd1;
#10
end
//sub
repeat (25) begin
a = $random;
b = $random;
control = 2'd0;
#10
end
//and 
repeat (25) begin
a = $random;
b = $random;
control = 2'd0;
#10
end 