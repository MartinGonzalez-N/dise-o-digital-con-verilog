	.cin(gnd),
	.combout(\always0~0_combout ),
	.cout());
// synopsys translate_off
defparam \always0~0 .lut_mask = 16'hF3CF;
defparam \always0~0 .sum_lutc_input = "datac";
// synopsys translate_on

assign sub[0] = \sub[0]~output_o ;

assign sub[1] = \sub[1]~output_o ;

assign sub[2] = \sub[2]~output_o ;

assign sub[3] = \sub[3]~output_o ;

assign sub[4] = \sub[4]~output_o ;

assign sub[5] = \sub[5]~output_o ;

assign sub[6] = \sub[6]~output_o ;

assign sub[7] = \sub[7]~output_o ;

assign overflow = \overflow~output_o ;

endmodule

module hard_block (

	devpor,
	devclrn,
	devoe);

// Design Ports Information
// ~ALTERA_ASDO_DATA1~	=>  Location: PIN_6,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_FLASH_nCE_nCSO~	=>  Location: PIN_8,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_DCLK~	=>  Location: PIN_12,	 I/O Standard: 2.5 V,	 Current Strength: Default
