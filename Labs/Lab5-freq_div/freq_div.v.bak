module freq_div #(parameter WIDTH = 32)	
				(input clk, 
				input arstn, 
				input [WIDTH-1:0]preset,
				input [WIDTH-1:0]threshold,
				output slow_clk);

reg[WIDTH-1:0]count		

always @(posedge clk or negedge arstn) begin
	if (!arstn)
		count <= {WIDTH{1'b0}};
	else begin
		if (preset == count)
			count <= {WIDTH{1'b0}};
		else
			count <= count + 1;
	end
end

assign slow_clk = threshold >= count;
endmodule