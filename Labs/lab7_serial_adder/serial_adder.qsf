set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY serial_adder
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "14:43:59  FEBRUARY 14, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name SYSTEMVERILOG_FILE serial_adder_tb.sv
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (SystemVerilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH serial_adder_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME serial_adder_tb -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id serial_adder_tb
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME serial_adder_tb -section_id serial_adder_tb
set_global_assignment -name EDA_TEST_BENCH_FILE serial_adder_tb.sv -section_id serial_adder_tb
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_AD27 -to in_b[3]
set_location_assignment PIN_AC27 -to in_b[2]
set_location_assignment PIN_AC28 -to in_b[1]
set_location_assignment PIN_AB28 -to in_b[0]
set_location_assignment PIN_AB26 -to in_a[3]
set_location_assignment PIN_AD26 -to in_a[2]
set_location_assignment PIN_AC26 -to in_a[1]
set_location_assignment PIN_AB27 -to in_a[0]
set_location_assignment PIN_Y2 -to clk
set_location_assignment PIN_M21 -to start
set_location_assignment PIN_Y23 -to rst
set_location_assignment PIN_E21 -to sum[0]
set_location_assignment PIN_E22 -to sum[1]
set_location_assignment PIN_E25 -to sum[2]
set_location_assignment PIN_E24 -to sum[3]
set_location_assignment PIN_H21 -to c
set_global_assignment -name VERILOG_FILE freq_div.sv
set_global_assignment -name VERILOG_FILE serial_adder.sv
set_global_assignment -name VERILOG_FILE adder.sv
set_global_assignment -name VERILOG_FILE control_fsm.sv
set_global_assignment -name VERILOG_FILE counter.sv
