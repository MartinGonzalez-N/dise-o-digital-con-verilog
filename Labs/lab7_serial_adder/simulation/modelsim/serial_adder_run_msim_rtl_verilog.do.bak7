transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -sv -work work +incdir+F:/SynologyDrive/Training/Nayarit\ Certificacion/Modulo\ 3\ Diseño\ de\ Sistemas\ Secuenciales\ (Intermedio)\ (Martin-Francisco)/labs_resueltos/projects/lab5_serial_adder {F:/SynologyDrive/Training/Nayarit Certificacion/Modulo 3 Diseño de Sistemas Secuenciales (Intermedio) (Martin-Francisco)/labs_resueltos/projects/lab5_serial_adder/serial_adder.sv}
