vlog -sv -work work +incdir+F:/SynologyDrive/Training/Nayarit\ Certificacion/Modulo\ 3\ Diseño\ de\ Sistemas\ Secuenciales\ (Intermedio)\ (Martin-Francisco)/labs_resueltos/projects/lab5_serial_adder {F:/SynologyDrive/Training/Nayarit Certificacion/Modulo 3 Diseño de Sistemas Secuenciales (Intermedio) (Martin-Francisco)/labs_resueltos/projects/lab5_serial_adder/input_reg.sv}
