module tb;
	parameter WIDTH = 4;
	reg [7:0]a,b;
	wire [7:0] sub;
	wire overflow;
	integer ref_a=0; 
	integer ref_b=0; 
	integer ref_sub=0;
	
	subtractor #(.WIDTH(WIDTH)) sub_i(.a(a),.b(b),.sub(sub),.overflow(overflow));
	
	initial begin
		repeat (100) begin
			a=$random;
			b=$random;
			ref_a = a;
			ref_b = b;
			ref_sub = ref_a - ref_b;
			
			check_sub:assert (ref_sub == sub);
			#10;
		end
	end
	
endmodule